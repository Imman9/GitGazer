generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  githubId    String       @unique
  username    String
  avatarUrl   String?
  accessToken String?
  createdAt   DateTime     @default(now())
  profile     UserProfile?
  activities  Activity[]
  badges      UserBadge[]
  quests      UserQuest[]
}

model UserProfile {
  id            String @id @default(cuid())
  userId        String @unique
  xp            Int    @default(0)
  level         Int    @default(0)
  theme         String @default("dark")
  avatarStage   Int    @default(0)
  currentStreak Int    @default(0)
  longestStreak Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  commits   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Badge {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  icon        String
  xpReward    Int
  description String

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Quest {
  id       String @id @default(cuid())
  key      String @unique
  name     String
  template String

  userQuests UserQuest[]
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  questId     String
  description String
  status      String   @default("pending") // pending, completed, expired
  rewardXp    Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id])
}
